<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Dalica.app's Info.plist. A template: packaging/macos/common.sh (render_info_plist) substitutes
     @APP_ID@ (crates/core/src/app_id.rs), @VERSION@ (full, e.g. 0.2.0-rc.1), @SHORT_VERSION@
     (numeric X.Y.Z) and @BUILD_SHA@.
     Adapted from PhotoCraft packaging/macos/Info.plist.in @ 77221725 (MIT OR Apache-2.0). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Dalica</string>
  <key>CFBundleName</key>
  <string>Dalica</string>
  <key>CFBundleExecutable</key>
  <string>Dalica</string>
  <key>CFBundleIdentifier</key>
  <string>@APP_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>DalicaVersion</key>
  <string>@VERSION@</string>
  <key>DalicaBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Dalica</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.photography</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in common.sh. Big Sur is the first release on Apple
       silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Dalica contributors. MIT OR Apache-2.0.</string>

  <!-- What macOS shows when Dalica first reads a protected folder the user added. -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>Dalica shows and organizes the photos in the folders you add to it.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Dalica shows and organizes the photos in the folders you add to it.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Dalica shows and organizes the photos in the folders you add to it.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Dalica shows and organizes the photos on the drives and cards you add to it.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Dalica shows and organizes the photos in the network folders you add to it.</string>

  <!-- Types older macOS releases may not declare; the system's own declaration wins when it has one. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>public.jpeg-xl</string>
      <key>UTTypeDescription</key>
      <string>JPEG XL image</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.image</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>jxl</string></array>
        <key>public.mime-type</key>
        <array><string>image/jxl</string></array>
      </dict>
    </dict>
  </array>

  <!-- The image formats Dalica shows (docs/formats.md §1), offered under Open With only:
       Alternate rank, so Dalica never takes over the default viewer. HEIC is left out while
       release builds leave out the heif feature; AVIF and video are not shown yet. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.jpeg</string>
        <string>public.png</string>
        <string>public.tiff</string>
        <string>org.webmproject.webp</string>
        <string>com.compuserve.gif</string>
        <string>com.microsoft.bmp</string>
        <string>public.jpeg-xl</string>
        <string>com.adobe.photoshop-image</string>
        <string>public.camera-raw-image</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
